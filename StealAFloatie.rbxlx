					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--[[
	Steal a Floatie — Config (ModuleScript in ReplicatedStorage.Shared)

	This is the ONE file you edit for most updates:
	  • add a new Floatie        -> Config.Floaties
	  • tune the economy         -> prices / income / Stages / Rebirth
	  • add a new event          -> Config.Events
	  • add a promo code         -> Config.Codes
	  • hook up Robux products   -> Config.GamePasses / Config.DevProducts
	  • recolor the HUD + panels -> Config.UI
	After editing, bump Config.Version so players see the update number.
]]

local Config = {}

---------------------------------------------------------------------
-- General
---------------------------------------------------------------------
Config.GameName = "Steal a Floatie"
Config.Version = "0.2.0"           -- bump every update, shown in the HUD
Config.DataStoreName = "FloatieData_v1" -- NEVER rename after launch (players lose saves)

-- Your Roblox UserId goes here so you can use admin chat commands in live servers
-- (in Studio, and for the place owner, commands always work).
Config.AdminUserIds = {
	-- 123456789,
}

Config.StartingAir = 100
Config.BaseWalkSpeed = 16

Config.BasePedestals = 10
Config.PedestalsPerRebirth = 2
Config.ExtraPedestalsAmount = 5     -- from the "+5 Pedestals" game pass
Config.MaxPedestals = 20            -- the map builds 20 pedestals per base

Config.SellRate = 0.5               -- sell for 50% of (price x size bonus x mutation)

Config.OfflineGrowthCap = 8 * 3600  -- Floaties keep inflating for up to 8h offline
Config.OfflineIncomeCap = 3 * 3600  -- offline Air counts for up to 3h...
Config.OfflineIncomeRate = 0.5      -- ...at 50% speed

Config.LockDuration = 60            -- base shield lasts 60s
Config.LockRecharge = 30            -- after it drops, 30s before you can lock again (raid window!)

Config.CarryTimeout = 90            -- a stolen Floatie floats home if not delivered in time
Config.DartRange = 90
Config.DartCooldown = 0.45
Config.DartKnockback = 45           -- dart hitting a player who is NOT carrying = small shove
Config.PopReward = 20               -- popping someone else's stolen Floatie pays 20s of its income

Config.PumpInterval = 3.5           -- a new Floatie appears on the Pump Line every X sec
Config.PumpTravelTime = 34          -- seconds to ride the whole line

Config.HomeCooldown = 3             -- seconds between Home teleports (server rate limit; the HUD uses it too).
                                    -- The server lets requests through 0.5 s early so network lag never eats a click.

---------------------------------------------------------------------
-- Game feel (client-side visuals only — safe to tweak any time)
---------------------------------------------------------------------
Config.Feel = {
	BobHeight = 0.35,     -- studs a Floatie floats up and down
	BobSpeed = 1.6,       -- bob cycles speed
	SquishAmount = 0.06,  -- 0.06 = stretches 6% taller / squats 3% wider
	SquishSpeed = 3.2,
	AnimDistance = 140,   -- only animate Floaties this close to the camera (performance)
}

---------------------------------------------------------------------
-- UI colors (client HUD + panels). Kit builds light-to-dark button
-- gradients from these automatically.
---------------------------------------------------------------------
Config.UI = {
	-- Text
	Text          = Color3.fromRGB(255, 255, 255), -- chunky white text
	TextDark      = Color3.fromRGB(55, 48, 85),    -- small text on light panels (no outline)
	Outline       = Color3.fromRGB(28, 22, 45),    -- text outlines, button + panel borders
	-- Surfaces
	PanelTop      = Color3.fromRGB(250, 248, 255), -- panel body gradient (top)
	PanelBottom   = Color3.fromRGB(205, 214, 245), -- panel body gradient (bottom)
	Row           = Color3.fromRGB(255, 255, 255), -- list rows inside panels
	Input         = Color3.fromRGB(255, 255, 255), -- text boxes
	HudBg         = Color3.fromRGB(30, 28, 48),    -- dark HUD plates (drawn ~15% transparent)
	-- Button / header colors
	Green         = Color3.fromRGB(70, 205, 95),
	Blue          = Color3.fromRGB(65, 150, 255),
	Orange        = Color3.fromRGB(255, 160, 40),
	Yellow        = Color3.fromRGB(255, 205, 50),
	Pink          = Color3.fromRGB(255, 95, 160),
	Purple        = Color3.fromRGB(150, 85, 245),
	Red           = Color3.fromRGB(235, 55, 65),   -- the big X and badges
	Grey          = Color3.fromRGB(135, 135, 155), -- disabled / owned
	-- HUD values
	Income        = Color3.fromRGB(120, 255, 140), -- "+12 Air/s"
	Luck          = Color3.fromRGB(110, 235, 110),
	Cash          = Color3.fromRGB(255, 210, 60),
	Gold          = Color3.fromRGB(255, 210, 90),  -- shop section headers
	Good          = Color3.fromRGB(120, 255, 140), -- code redeemed
	Bad           = Color3.fromRGB(255, 120, 120), -- code error
	-- Boxes under the top bar (same colors as v0.1.2)
	EventBanner   = Color3.fromRGB(120, 60, 210),
	EventDesc     = Color3.fromRGB(230, 220, 255),
	CarryBox      = Color3.fromRGB(200, 60, 60),
	TutorialBox   = Color3.fromRGB(255, 225, 90),
	TutorialArrow = Color3.fromRGB(255, 230, 60),
	-- Toasts by kind (same colors as v0.1.2)
	Toast = {
		info    = Color3.fromRGB(45, 45, 70),
		success = Color3.fromRGB(40, 150, 90),
		error   = Color3.fromRGB(190, 60, 70),
		alert   = Color3.fromRGB(230, 70, 40),
		event   = Color3.fromRGB(140, 70, 220),
	},
}

---------------------------------------------------------------------
-- Rarities (weight = chance to appear on the Pump Line)
---------------------------------------------------------------------
Config.Rarities = {
	Common    = { order = 1, weight = 58,   color = Color3.fromRGB(225, 225, 225) },
	Uncommon  = { order = 2, weight = 26,   color = Color3.fromRGB(95, 210, 120) },
	Rare      = { order = 3, weight = 11,   color = Color3.fromRGB(80, 150, 255) },
	Epic      = { order = 4, weight = 4,    color = Color3.fromRGB(175, 95, 255) },
	Legendary = { order = 5, weight = 0.85, color = Color3.fromRGB(255, 195, 45) },
	Mythic    = { order = 6, weight = 0.15, color = Color3.fromRGB(255, 70, 115) },
	Secret    = { order = 7, weight = 0,    color = Color3.fromRGB(20, 20, 20) }, -- events / codes only
}

---------------------------------------------------------------------
-- Floaties — original balloon-animal characters.
-- shape = how the balloon animal is twisted together (all optional):
--   body, r (body length / radius), leg, legs (count, default 4),
--   neck, head, ear, tail, snout, shell, horn, wings, antlers, spikes, spout
---------------------------------------------------------------------
Config.Floaties = {
	-- Common
	{ id = "Pupfloat",   name = "Pupfloat",   rarity = "Common",   price = 25,     income = 1,
		color = Color3.fromRGB(255, 125, 160), shape = { body = 3, r = 0.8, leg = 1.6, neck = 1.2, head = 1.5, ear = 1.4, tail = 1.2 } },
	{ id = "Kittiloon",  name = "Kittiloon",  rarity = "Common",   price = 50,     income = 2,
		color = Color3.fromRGB(255, 170, 70), shape = { body = 2.6, r = 0.75, leg = 1.3, neck = 0.8, head = 1.6, ear = 0.8, tail = 2 } },
	{ id = "Bunbob",     name = "Bunbob",     rarity = "Common",   price = 90,     income = 3,
		color = Color3.fromRGB(245, 245, 255), shape = { body = 2, r = 0.9, leg = 1, neck = 0.6, head = 1.5, ear = 2.4, tail = 0.4 } },
	-- Uncommon
	{ id = "Snailoon",   name = "Snailoon",   rarity = "Uncommon", price = 300,    income = 9,
		color = Color3.fromRGB(150, 220, 90), shape = { body = 3.4, r = 0.7, leg = 0, neck = 1.6, head = 1.1, ear = 1, shell = 2.4 } },
	{ id = "Duckpuff",   name = "Duckpuff",   rarity = "Uncommon", price = 500,    income = 14,
		color = Color3.fromRGB(255, 230, 60), shape = { body = 2.4, r = 1, leg = 0.9, neck = 1.2, head = 1.4, tail = 0.6, snout = 1.2 } },
	{ id = "Froggle",    name = "Froggle",    rarity = "Uncommon", price = 800,    income = 21,
		color = Color3.fromRGB(60, 190, 90), shape = { body = 2.2, r = 1.1, leg = 1.2, neck = 0.3, head = 1.9, ear = 0.6 } },
	-- Rare
	{ id = "Giraffloat", name = "Giraffloat", rarity = "Rare",     price = 3000,   income = 70,
		color = Color3.fromRGB(240, 190, 90), shape = { body = 3, r = 0.8, leg = 2.6, neck = 4.2, head = 1.3, ear = 0.7, tail = 1 } },
	{ id = "Octopuff",   name = "Octopuff",   rarity = "Rare",     price = 5000,   income = 110,
		color = Color3.fromRGB(190, 90, 255), shape = { body = 1.2, r = 1.6, leg = 2.4, legs = 8, head = 2.4 } },
	{ id = "Pengloon",   name = "Pengloon",   rarity = "Rare",     price = 8000,   income = 160,
		color = Color3.fromRGB(45, 55, 80), shape = { body = 2, r = 1.2, leg = 0.8, neck = 0.6, head = 1.5, tail = 0.5, snout = 0.8 } },
	-- Epic
	{ id = "Dinoloon",   name = "Dinoloon",   rarity = "Epic",     price = 30000,  income = 550,
		color = Color3.fromRGB(80, 200, 170), shape = { body = 3.6, r = 1, leg = 1.8, neck = 2.4, head = 1.7, tail = 3.2, spikes = true } },
	{ id = "Unipuff",    name = "Unipuff",    rarity = "Epic",     price = 50000,  income = 850,
		color = Color3.fromRGB(255, 200, 240), shape = { body = 3.2, r = 0.9, leg = 2.2, neck = 1.8, head = 1.5, ear = 0.8, tail = 1.6, horn = 1.6 } },
	-- Legendary
	{ id = "Dragonflate", name = "Dragonflate", rarity = "Legendary", price = 200000, income = 2800,
		color = Color3.fromRGB(230, 60, 60), shape = { body = 3.8, r = 1.1, leg = 1.8, neck = 2.2, head = 1.9, ear = 1, tail = 3, wings = 3.4, horn = 0.9 } },
	{ id = "Whaleloon",  name = "Whaleloon",  rarity = "Legendary", price = 320000, income = 4400,
		color = Color3.fromRGB(70, 130, 230), shape = { body = 5, r = 1.9, leg = 0, tail = 2.4, spout = true } },
	-- Mythic
	{ id = "Cosmoose",   name = "Cosmoose",   rarity = "Mythic",   price = 1500000, income = 17000,
		color = Color3.fromRGB(60, 35, 130), shape = { body = 4, r = 1.3, leg = 2.8, neck = 1.8, head = 2, tail = 0.8, antlers = 3 } },
	-- Secret (never on the Pump Line normally — events, codes and admin only)
	{ id = "Stormserpent", name = "Stormserpent", rarity = "Secret", price = 5000000, income = 60000,
		color = Color3.fromRGB(35, 40, 60), shape = { body = 7, r = 1, leg = 0, neck = 2.4, head = 2, tail = 4, horn = 1.4, wings = 2.4 } },
}

---------------------------------------------------------------------
-- Inflation stages — THE core twist.
-- Floaties inflate on your base over time (even offline).
-- Bigger = more income, BUT whoever steals it floats higher (lift),
-- walks slower (slow), needs longer to grab it (stealTime),
-- and it takes more darts to pop it (popHits).
---------------------------------------------------------------------
Config.Stages = {
	{ name = "Deflated", scale = 1.00, income = 1.0, growTime = 90,   lift = 0.15, slow = 0, stealTime = 1.5, popHits = 2 },
	{ name = "Puffy",    scale = 1.35, income = 1.7, growTime = 300,  lift = 0.30, slow = 2, stealTime = 2.0, popHits = 3 },
	{ name = "Round",    scale = 1.70, income = 2.8, growTime = 900,  lift = 0.45, slow = 4, stealTime = 2.5, popHits = 3 },
	{ name = "Chonky",   scale = 2.10, income = 4.5, growTime = 2400, lift = 0.60, slow = 6, stealTime = 3.0, popHits = 4 },
	{ name = "MEGA",     scale = 2.60, income = 7.0, growTime = nil,  lift = 0.75, slow = 8, stealTime = 4.0, popHits = 5 },
}

---------------------------------------------------------------------
-- Mutations (rolled when a Floatie appears on the Pump Line).
-- Checked rarest-first (bottom of the list first).
---------------------------------------------------------------------
Config.Mutations = {
	{ id = "Normal",  mult = 1,   chance = 0 },
	{ id = "Glitter", mult = 1.5, chance = 0.08 },
	{ id = "Neon",    mult = 2,   chance = 0.035 },
	{ id = "Foil",    mult = 3,   chance = 0.012 },
	{ id = "Rainbow", mult = 5,   chance = 0.003 },
	{ id = "Thunder", mult = 8,   chance = 0, eventOnly = "Thunderstorm", eventChance = 0.03 },
}

---------------------------------------------------------------------
-- Rebirth: resets Air + Floaties (you KEEP your single best Floatie),
-- gives +50% income forever and +2 pedestals.
---------------------------------------------------------------------
Config.RebirthIncomeBonus = 0.5
function Config.RebirthCost(rebirths)
	return 250000 * (5 ^ rebirths)
end

---------------------------------------------------------------------
-- Automatic server events (every EventInterval seconds)
---------------------------------------------------------------------
Config.EventInterval = 15 * 60
Config.Events = {
	HeliumRain   = { title = "🎈 HELIUM RAIN",  desc = "Mutation chance x4 on the Pump Line!", duration = 180, mutationMult = 4 },
	GoldenHour   = { title = "✨ GOLDEN HOUR",  desc = "All Floaties earn 2x Air!",            duration = 180, incomeMult = 2 },
	WindyDay     = { title = "🌬️ WINDY DAY",    desc = "Gusts shove anyone carrying a Floatie!", duration = 180, wind = true },
	Thunderstorm = { title = "⛈️ THUNDERSTORM", desc = "Thunder Floaties (x8) can appear!",   duration = 150, mutationMult = 1.5 },
	SecretSkies  = { title = "🌌 SECRET SKIES", desc = "A Stormserpent may drift down the Pump Line!", duration = 120, secretChance = 0.01 },
}

---------------------------------------------------------------------
-- Promo codes (post these on TikTok / Discord / the game description)
---------------------------------------------------------------------
Config.Codes = {
	RELEASE = { air = 500 },
	FLOATIE = { floatie = "Kittiloon", mutation = "Glitter" },
	-- LIKES1K = { air = 5000 },   -- example: add when the game hits 1,000 likes
}

---------------------------------------------------------------------
-- Robux products. Create them on create.roblox.com, then paste the IDs.
-- id = 0 means "not set up yet" (the shop button tells the player "coming soon").
---------------------------------------------------------------------
Config.GamePasses = {
	DoubleAir      = { id = 0, title = "2x Air",       desc = "Double all Air forever",         price = 199 },
	VIP            = { id = 0, title = "VIP",          desc = "+20% Air and a gold VIP tag",    price = 149 },
	ExtraPedestals = { id = 0, title = "+5 Pedestals", desc = "Hold 5 more Floaties",           price = 249 },
	FastInflate    = { id = 0, title = "Fast Inflate", desc = "Your Floaties grow 1.5x faster", price = 179 },
}
Config.DevProducts = {
	AirPackSmall     = { id = 0, title = "Air Pack",           desc = "5 minutes of your income (min 500)",   price = 29 },
	AirPackLarge     = { id = 0, title = "Big Air Pack",       desc = "30 minutes of your income (min 3K)",   price = 129 },
	InstantLock      = { id = 0, title = "Instant Lock",       desc = "Lock your base right now",             price = 15 },
	ServerHeliumRain = { id = 0, title = "Server Helium Rain", desc = "Start Helium Rain for EVERYONE",       price = 99 },
}
-- Set true to pretend you own every pass while testing in Studio.
Config.TestPassesInStudio = false

---------------------------------------------------------------------
-- Sounds. The defaults are Roblox's built-in sounds so the game isn't silent.
-- To use better ones: Studio > Toolbox > Audio, search (e.g. "balloon pop"),
-- right-click a sound > Copy Asset ID, and paste it here as "rbxassetid://123456".
-- "" = no sound.
---------------------------------------------------------------------
Config.Sounds = {
	Pop     = { id = "rbxasset://sounds/snap.mp3",               volume = 0.8 },  -- a Floatie pops
	Buy     = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5 }, -- success toasts (buy, steal, sell)
	Alert   = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.9, pitch = 0.6 }, -- someone is stealing yours
	Error   = { id = "rbxasset://sounds/button.wav",              volume = 0.5, pitch = 0.7 },
	Dart    = { id = "rbxasset://sounds/swoosh.wav",              volume = 0.4, pitch = 1.6 },
	Click   = { id = "rbxasset://sounds/button.wav",              volume = 0.4 },
	Event   = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.7, pitch = 1.3 },
	Music   = { id = "", volume = 0.25 },  -- paste a music asset id to add looping background music
}

---------------------------------------------------------------------
-- Lookups + helpers (no need to edit below)
---------------------------------------------------------------------
Config.FloatieById = {}
for _, f in ipairs(Config.Floaties) do
	Config.FloatieById[f.id] = f
end
Config.MutationById = {}
for _, m in ipairs(Config.Mutations) do
	Config.MutationById[m.id] = m
end

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }
function Config.Format(n)
	n = tonumber(n) or 0
	if n < 1000 then
		return tostring(math.floor(n))
	end
	local i = 1
	while n >= 1000 and i < #SUFFIXES do
		n /= 1000
		i += 1
	end
	local fmt = "%.0f%s"
	if n < 10 then
		fmt = "%.2f%s"
	elseif n < 100 then
		fmt = "%.1f%s"
	end
	return string.format(fmt, n, SUFFIXES[i])
end

function Config.FormatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	local m = math.floor(seconds / 60)
	local s = seconds % 60
	if m >= 60 then
		return string.format("%dh %02dm", math.floor(m / 60), m % 60)
	end
	return string.format("%d:%02d", m, s)
end

return Config
]]></ProtectedString>
					<string name="ScriptGuid">{486FFDA2-AD83-4455-A75A-ADA3EFAFF4DB}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Config</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">118bb205a2b353690aca71c2000003db</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX2">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--[[
	FloatieModel (ModuleScript in ReplicatedStorage.Shared)
	Builds balloon-animal models out of stretched spheres — no 3D modeling needed.
	Every Floatie is built from its `shape` table in Config, at any inflation scale.

	Model layout:
	  Model.PrimaryPart = "Root" (invisible, at the feet, anchored while on a pedestal)
	  every other part is welded to Root, unanchored, massless, non-colliding
	  "Body" part = the main balloon, parts with attribute Paint = recolorable
	  Root.Label = BillboardGui with name / stage / income
]]

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")

local Config = require(script.Parent:WaitForChild("Config"))

local FloatieModel = {}

local V = Vector3.new
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local GOLD = Color3.fromRGB(255, 215, 90)
local BEAK = Color3.fromRGB(255, 150, 40)

local function newPart(ctx, name, size, cf, color, paint)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Reflectance = 0.12
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = true
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	if paint then
		p:SetAttribute("Paint", true)
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = ctx.root
	weld.Part1 = p
	weld.Parent = p
	p.Parent = ctx.model
	ctx.top = math.max(ctx.top, cf.Position.Y + size.Y / 2)
	return p
end

-- a long balloon "segment" between two points (positions in unscaled units)
local function segment(ctx, name, a, b, radius, color, paint)
	local k = ctx.k
	a, b, radius = a * k, b * k, radius * k
	local dir = b - a
	local len = dir.Magnitude
	if len < 0.05 then
		return nil
	end
	local up = if math.abs(dir.Unit.Y) > 0.95 then Vector3.xAxis else Vector3.yAxis
	local cf = CFrame.lookAt((a + b) / 2, b, up)
	local p = newPart(ctx, name, V(radius * 2, radius * 2, len + radius), cf, color, paint)
	ctx.top = math.max(ctx.top, math.max(a.Y, b.Y) + radius)
	return p
end

-- a round blob (ellipsoid) at a point
local function blob(ctx, name, center, size, color, paint, rot)
	local k = ctx.k
	return newPart(ctx, name, size * k, CFrame.new(center * k) * (rot or CFrame.identity), color, paint)
end

local function addLabel(model, root, height)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromOffset(220, 74)
	gui.StudsOffsetWorldSpace = V(0, height + 1.4, 0)
	gui.MaxDistance = 75
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Adornee = root
	gui.Parent = root

	local layout = Instance.new("UIListLayout")
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = gui

	local function line(name, order, size, color)
		local t = Instance.new("TextLabel")
		t.Name = name
		t.LayoutOrder = order
		t.Size = UDim2.new(1, 0, 0, size)
		t.BackgroundTransparency = 1
		t.Font = Enum.Font.FredokaOne
		t.TextScaled = true
		t.TextColor3 = color
		t.TextStrokeTransparency = 0.2
		t.Text = ""
		t.Parent = gui
		return t
	end
	line("Extra", 1, 16, Color3.fromRGB(255, 240, 140))
	line("Rarity", 2, 14, WHITE)
	line("NameLine", 3, 22, WHITE)
	line("Info", 4, 14, Color3.fromRGB(210, 230, 255))
	line("Income", 5, 16, Color3.fromRGB(120, 255, 140))
end

local function sparkles(parent, color, rate)
	local e = Instance.new("ParticleEmitter")
	e.Name = "Sparkles"
	e.Rate = rate or 8
	e.Lifetime = NumberRange.new(0.6, 1.2)
	e.Speed = NumberRange.new(1, 3)
	e.SpreadAngle = Vector2.new(180, 180)
	e.LightEmission = 1
	e.Size = NumberSequence.new(0.35, 0)
	e.Color = ColorSequence.new(color)
	e.Parent = parent
	return e
end

local function applyMutation(model, mutId)
	local body = model:FindFirstChild("Body")
	for _, p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") and p:GetAttribute("Paint") then
			if mutId == "Neon" then
				p.Material = Enum.Material.Neon
			elseif mutId == "Foil" then
				p.Material = Enum.Material.Foil
				p.Reflectance = 0.35
			elseif mutId == "Glitter" or mutId == "Rainbow" then
				p.Reflectance = 0.3
			end
		end
	end
	if not body then
		return
	end
	if mutId == "Glitter" then
		sparkles(body, Color3.fromRGB(255, 245, 200), 10)
	elseif mutId == "Rainbow" then
		CollectionService:AddTag(model, "RainbowFloatie") -- the client cycles the colors
		sparkles(body, WHITE, 14)
	elseif mutId == "Thunder" then
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 240, 120)
		light.Range = 14
		light.Brightness = 2
		light.Parent = body
		sparkles(body, Color3.fromRGB(255, 240, 80), 20)
		for _, p in ipairs(model:GetChildren()) do
			if p.Name == "Eye" then
				p.Color = Color3.fromRGB(255, 240, 80)
				p.Material = Enum.Material.Neon
			end
		end
	end
end

--[[
	BuildFromMesh: uses a hand-made or AI-made 3D model instead of the balloon shapes.
	How to add one:
	  1. Studio > File > Import 3D (or Avatar tab > Import 3D), pick the .glb / .fbx / .obj.
	  2. Rotate it so its HEAD points along the red X arrow.
	  3. Make a Folder named "FloatieMeshes" in ReplicatedStorage and put the model
	     inside it, renamed to the Floatie id (e.g. "Dragonflate").
	The game scales it to the Floatie's size and inflates it like any other Floatie.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

function FloatieModel.BuildFromMesh(model, root, def, mutId, scale)
	local folder = ReplicatedStorage:FindFirstChild("FloatieMeshes")
	local source = folder and folder:FindFirstChild(def.id)
	if not source then
		return nil
	end
	local copy = source:Clone()
	local parts = {}
	if copy:IsA("BasePart") then
		table.insert(parts, copy)
	end
	for _, d in ipairs(copy:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	if #parts == 0 then
		copy:Destroy()
		return nil
	end

	local boxCf, boxSize
	if copy:IsA("Model") then
		boxCf, boxSize = copy:GetBoundingBox()
	else
		boxCf, boxSize = copy.CFrame, copy.Size
	end
	boxCf = CFrame.new(boxCf.Position) -- keep the rotation you gave it in Studio

	-- target length roughly matches the balloon version of this Floatie
	local s = def.shape
	local targetLen = ((s.body or 3) + (s.head or 0) + (s.tail or 0) * 0.5 + 1) * scale
	local k = targetLen / math.max(boxSize.X, boxSize.Z, 0.1)

	local biggest, biggestVol = nil, -1
	for _, p in ipairs(parts) do
		local offset = boxCf:PointToObjectSpace(p.Position) * k
		local rot = p.CFrame - p.Position
		p.Anchored = false
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = true
		p.Massless = true
		p.Size = p.Size * k
		p.CFrame = CFrame.new(offset + Vector3.new(0, boxSize.Y * k / 2, 0)) * rot
		p:SetAttribute("Paint", true)
		p.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = p
		weld.Parent = p
		local vol = p.Size.X * p.Size.Y * p.Size.Z
		if vol > biggestVol then
			biggest, biggestVol = p, vol
		end
	end
	biggest.Name = "Body"
	copy:Destroy()

	local top = boxSize.Y * k
	applyMutation(model, mutId)
	model:SetAttribute("Height", top)
	model:SetAttribute("FloatieId", def.id)
	model:SetAttribute("Mutation", mutId)
	addLabel(model, root, top)
	return model
end

--[[
	Build(def, mutationId, scale) -> Model
	def   = an entry from Config.Floaties
	scale = inflation scale (Config.Stages[i].scale)
]]
function FloatieModel.Build(def, mutId, scale)
	scale = scale or 1
	mutId = mutId or "Normal"

	local model = Instance.new("Model")
	model.Name = def.name
	CollectionService:AddTag(model, "Floatie") -- the client animates these (bob / squish)

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = V(0.4, 0.4, 0.4)
	root.Transparency = 1
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Anchored = true
	root.Massless = true
	root.CFrame = CFrame.identity
	root.Parent = model
	model.PrimaryPart = root

	-- Custom 3D model? (e.g. a Higgsfield/Meshy mesh imported in Studio and put in
	-- ReplicatedStorage > FloatieMeshes, named exactly like the Floatie's id)
	local custom = FloatieModel.BuildFromMesh(model, root, def, mutId, scale)
	if custom then
		return custom
	end

	local ctx = { model = model, root = root, k = scale, top = 0 }
	local s = def.shape
	local c = def.color
	if mutId == "Thunder" then
		c = Color3.fromRGB(45, 45, 85)
	end
	local accent = c:Lerp(WHITE, 0.35)
	local knotColor = c:Lerp(BLACK, 0.3)
	local eyeColor = Color3.fromRGB(20, 20, 30)

	local r = s.r or 1
	local L = s.body or 3
	local leg = s.leg or 0
	local head = s.head or 0
	local neck = s.neck or 0
	local bodyY = if leg > 0 then leg + r * 0.7 else r

	-- body (the main balloon)
	segment(ctx, "Body", V(-L / 2, bodyY, 0), V(L / 2, bodyY, 0), r, c, true)

	-- legs
	if s.legs then
		for i = 1, s.legs do
			local ang = (i / s.legs) * math.pi * 2
			local dx, dz = math.cos(ang), math.sin(ang)
			local reach = r * 0.6 + leg * 0.7
			segment(ctx, "Leg", V(dx * r * 0.5, bodyY - r * 0.3, dz * r * 0.5), V(dx * reach, 0.25, dz * reach), 0.32, c, true)
		end
	elseif leg > 0 then
		local lx, lz = L / 2 - r * 0.5, r * 0.5
		for _, p in ipairs({ V(lx, 0, lz), V(lx, 0, -lz), V(-lx, 0, lz), V(-lx, 0, -lz) }) do
			segment(ctx, "Leg", V(p.X, bodyY, p.Z), V(p.X, 0.25, p.Z), r * 0.4, c, true)
		end
	end

	-- neck + head
	local headC
	if head > 0 then
		if neck > 0 then
			local a = V(L / 2 - r * 0.2, bodyY + r * 0.3, 0)
			local b = a + V(neck * 0.35, neck, 0)
			segment(ctx, "Neck", a, b, r * 0.45, c, true)
			headC = b + V(head * 0.25, head * 0.3, 0)
		else
			headC = V(L / 2 + head * 0.3, bodyY + r * 0.4, 0)
		end
		blob(ctx, "Head", headC, V(head * 1.15, head, head), c, true)
		for _, z in ipairs({ head * 0.24, -head * 0.24 }) do
			blob(ctx, "Eye", V(headC.X + head * 0.48, headC.Y + head * 0.12, z), V(1, 1, 1) * head * 0.2, eyeColor, false)
		end
	else
		headC = V(L / 2 - r * 0.4, bodyY + r * 0.2, 0)
		for _, z in ipairs({ r * 0.8, -r * 0.8 }) do
			blob(ctx, "Eye", V(L / 2 - r * 0.6, bodyY + r * 0.25, z), V(1, 1, 1) * r * 0.22, eyeColor, false)
		end
	end

	-- ears
	if (s.ear or 0) > 0 and head > 0 then
		for _, sz in ipairs({ 1, -1 }) do
			segment(ctx, "Ear",
				headC + V(-head * 0.1, head * 0.35, sz * head * 0.22),
				headC + V(-head * 0.25, head * 0.35 + s.ear, sz * head * 0.4),
				head * 0.15, c, true)
		end
	end

	-- snout / beak
	if s.snout and head > 0 then
		segment(ctx, "Snout", headC + V(head * 0.4, -head * 0.1, 0), headC + V(head * 0.55 + s.snout, -head * 0.12, 0), head * 0.2, BEAK, false)
	end

	-- tail + the balloon knot (every balloon animal has one!)
	if (s.tail or 0) > 0 then
		local a = V(-L / 2 + r * 0.2, bodyY, 0)
		local b = V(-L / 2 - s.tail * 0.45, bodyY + s.tail * 0.8, 0)
		segment(ctx, "Tail", a, b, r * 0.33, c, true)
		blob(ctx, "Knot", b, V(0.45, 0.45, 0.45), knotColor, false)
	else
		blob(ctx, "Knot", V(-L / 2 - r * 0.05, bodyY, 0), V(0.45, 0.45, 0.45), knotColor, false)
	end

	-- extras
	if s.shell then
		blob(ctx, "Shell", V(-L * 0.05, bodyY + r * 0.6 + s.shell * 0.35, 0), V(s.shell, s.shell, s.shell * 0.75), accent, true)
	end
	if s.horn and head > 0 then
		segment(ctx, "Horn", headC + V(head * 0.15, head * 0.4, 0), headC + V(head * 0.15 + s.horn * 0.35, head * 0.4 + s.horn, 0), 0.22, GOLD, false)
	end
	if s.wings then
		for _, sz in ipairs({ 1, -1 }) do
			blob(ctx, "Wing", V(0, bodyY + r * 0.7, sz * (r * 0.6 + s.wings * 0.45)), V(s.wings * 0.9, 0.35, s.wings), accent, true, CFrame.Angles(-sz * 0.45, 0, 0))
		end
	end
	if s.antlers and head > 0 then
		for _, sz in ipairs({ 1, -1 }) do
			local a = headC + V(-head * 0.1, head * 0.4, sz * head * 0.2)
			local b = a + V(-0.3, s.antlers * 0.7, sz * s.antlers * 0.5)
			segment(ctx, "Antler", a, b, 0.22, GOLD, false)
			local m = a:Lerp(b, 0.55)
			segment(ctx, "Antler", m, m + V(s.antlers * 0.35, s.antlers * 0.3, sz * 0.2), 0.18, GOLD, false)
		end
	end
	if s.spikes then
		for i = -1, 1 do
			blob(ctx, "Spike", V(i * L * 0.25, bodyY + r * 0.95, 0), V(0.7, 1.1, 0.35), accent, true)
		end
	end
	if s.spout then
		for i = -1, 1 do
			segment(ctx, "Spout", V(L * 0.2, bodyY + r * 0.9, 0), V(L * 0.2 + i * 0.8, bodyY + r * 0.9 + 2.2, i * 0.3), 0.18, Color3.fromRGB(160, 220, 255), false)
		end
	end

	applyMutation(model, mutId)
	model:SetAttribute("Height", ctx.top)
	model:SetAttribute("FloatieId", def.id)
	model:SetAttribute("Mutation", mutId)
	addLabel(model, root, ctx.top)
	return model
end

-- Anchored = sits still (pedestal / pump line). Unanchored = can be welded to a player.
function FloatieModel.SetAnchored(model, anchored)
	model.PrimaryPart.Anchored = anchored
end

--[[
	SetLabel(model, def, mutationId, stageIndex, incomePerSec, extraText)
]]
function FloatieModel.SetLabel(model, def, mutId, stageIndex, incomePerSec, extra)
	local gui = model.PrimaryPart and model.PrimaryPart:FindFirstChild("Label")
	if not gui then
		return
	end
	local rarity = Config.Rarities[def.rarity]
	local stage = Config.Stages[stageIndex] or Config.Stages[1]
	gui.NameLine.Text = def.name
	gui.Rarity.Text = string.upper(def.rarity)
	gui.Rarity.TextColor3 = if def.rarity == "Secret" then WHITE else rarity.color
	local info = stage.name
	if mutId and mutId ~= "Normal" then
		info = mutId .. " • " .. info
	end
	gui.Info.Text = info
	gui.Income.Text = "+" .. Config.Format(incomePerSec) .. " Air/s"
	gui.Extra.Text = extra or ""
end

-- Confetti burst + "POP!" text at a position (server-side, replicates to everyone)
function FloatieModel.PopEffect(position, color)
	local p = Instance.new("Part")
	p.Name = "PopEffect"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = V(1, 1, 1)
	p.Position = position
	p.Parent = workspace

	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.Speed = NumberRange.new(18, 34)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Lifetime = NumberRange.new(0.5, 0.9)
	e.Size = NumberSequence.new(0.8, 0)
	e.Drag = 3
	e.Rate = 350
	e.Parent = p

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 80)
	gui.AlwaysOnTop = true
	gui.Parent = p
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = "POP!"
	t.TextColor3 = WHITE
	t.TextStrokeTransparency = 0
	t.Parent = gui

	task.delay(0.15, function()
		e.Enabled = false
	end)
	Debris:AddItem(p, 1.5)
end

return FloatieModel
]]></ProtectedString>
					<string name="ScriptGuid">{D705E3A8-80C0-4FFD-86EE-AC023EACBC44}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">FloatieModel</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">118bb205a2b353690aca71c2000003dc</UniqueId>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX9">
		<Properties>
			<bool name="LoadStringEnabled">false</bool>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
			<string name="Name">ServerScriptService</string>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">118bb205a2b353690aca71c2000003be</UniqueId>
		</Properties>
		<Item class="Script" referent="RBX5">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--[[
	Steal a Floatie — GameServer (Script in ServerScriptService)

	Core loop:
	  1. Buy Floaties (balloon animals) from the Pump Line with Air.
	  2. They sit on your pedestals, earn Air every second, and INFLATE over time
	     (Deflated -> Puffy -> Round -> Chonky -> MEGA). Bigger = more Air.
	  3. Sneak into other bases and hold E to steal a Floatie. It sits on your head
	     and makes you FLOAT — the bigger it is, the lighter and slower you get.
	  4. Get it home to keep it. Defenders shoot it with the Dart Blaster -> POP,
	     it flies back to its owner.
	  5. Lock your base, rebirth for multipliers, catch mutations and server events.

	Admin chat commands (Studio, the place owner, or Config.AdminUserIds):
	  ;event HeliumRain      ;give Dragonflate Rainbow      ;air 100000      ;grow
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local FloatieModel = require(Shared:WaitForChild("FloatieModel"))
local ServerFolder = script.Parent:WaitForChild("Server")
local DataService = require(ServerFolder:WaitForChild("DataService"))
local MapBuilder = require(ServerFolder:WaitForChild("MapBuilder"))

local rng = Random.new()

---------------------------------------------------------------------
-- Remotes
---------------------------------------------------------------------
local Remotes = Instance.new("Folder")
Remotes.Name = "Remotes"
local function remote(name, className)
	local r = Instance.new(className or "RemoteEvent")
	r.Name = name
	r.Parent = Remotes
	return r
end
local NotifyRE = remote("Notify")
local FireDartRE = remote("FireDart")
local KnockbackRE = remote("Knockback")
local RebirthRE = remote("Rebirth")
local RedeemRF = remote("RedeemCode", "RemoteFunction")
local RequestHomeRE = remote("RequestHome") -- HUD Home button (no arguments)
Remotes.Parent = ReplicatedStorage

---------------------------------------------------------------------
-- State
---------------------------------------------------------------------
local map = MapBuilder.Build()
local bases = map.bases
for _, base in ipairs(bases) do
	base.owner = nil
	base.models = {}    -- [slot] = Model
	base.slotData = {}  -- [slot] = floatie data table
	base.lockedUntil = 0
	base.lockReadyAt = 0
end

local profiles = {}     -- [Player] = { data, canSave, base, passes, incomePerSec, dartReady, homeReady, loaded }
local carries = {}      -- [thief Player] = carry info
local carriedKeys = {}  -- ["ownerUserId:uid"] = true while that Floatie is on someone's head
local lineItems = {}    -- Floaties riding the Pump Line

local function now()
	return workspace:GetServerTimeNow()
end

local function notify(player, text, kind)
	NotifyRE:FireClient(player, text, kind or "info")
end

local function notifyAll(text, kind)
	NotifyRE:FireAllClients(text, kind or "info")
end

local function carryKey(owner, uid)
	return tostring(owner.UserId) .. ":" .. tostring(uid)
end

local function hasPass(player, name)
	local prof = profiles[player]
	return prof ~= nil and prof.passes[name] == true
end

local function activeEvent()
	local name = ReplicatedStorage:GetAttribute("Event")
	if name and name ~= "" and (ReplicatedStorage:GetAttribute("EventEndsAt") or 0) > now() then
		return Config.Events[name], name
	end
	return nil, nil
end

local function pedestalCount(player)
	local prof = profiles[player]
	if not prof then
		return 0
	end
	local n = Config.BasePedestals + prof.data.rebirths * Config.PedestalsPerRebirth
	if hasPass(player, "ExtraPedestals") then
		n += Config.ExtraPedestalsAmount
	end
	return math.min(n, Config.MaxPedestals)
end

local function incomeMultiplier(player)
	local prof = profiles[player]
	local m = 1 + prof.data.rebirths * Config.RebirthIncomeBonus
	if hasPass(player, "DoubleAir") then
		m *= 2
	end
	if hasPass(player, "VIP") then
		m *= 1.2
	end
	local ev = activeEvent()
	if ev and ev.incomeMult then
		m *= ev.incomeMult
	end
	return m
end

local function growthMultiplier(player)
	return if hasPass(player, "FastInflate") then 1.5 else 1
end

-- Luck shown on the HUD. Stage 2 (Lucky Breeze) makes this real.
local function luckMultiplier(_player)
	return 1
end

-- numbers the HUD reads: Cash = the real income multiplier
-- (rebirths x DoubleAir x VIP x event incomeMult, see incomeMultiplier)
local function publishMultipliers(player)
	local prof = profiles[player]
	if not prof then
		return
	end
	local cash = incomeMultiplier(player)
	player:SetAttribute("CashMultiplier", cash)
	player:SetAttribute("LuckMultiplier", luckMultiplier(player))
	player:SetAttribute("BoostPercent", math.floor((cash - 1) * 100 + 0.5))
end

-- income per second of one Floatie BEFORE the player's multipliers
local function floatieIncome(f)
	local def = Config.FloatieById[f.id]
	if not def then
		return 0
	end
	local st = Config.Stages[f.stage] or Config.Stages[1]
	local mut = Config.MutationById[f.mut] or Config.MutationById.Normal
	return def.income * st.income * mut.mult
end

local function sellValue(f)
	local def = Config.FloatieById[f.id]
	local st = Config.Stages[f.stage] or Config.Stages[1]
	local mut = Config.MutationById[f.mut] or Config.MutationById.Normal
	return math.floor(def.price * Config.SellRate * st.income * mut.mult)
end

local function findFloatie(data, uid)
	for i, f in ipairs(data.floaties) do
		if f.uid == uid then
			return f, i
		end
	end
	return nil, nil
end

local function newUid(prof)
	local uid = prof.data.nextUid
	prof.data.nextUid += 1
	return uid
end

local function freeSlot(player)
	local prof = profiles[player]
	if not prof then
		return nil
	end
	local used = {}
	for _, f in ipairs(prof.data.floaties) do
		if f.slot then
			used[f.slot] = true
		end
	end
	for s = 1, pedestalCount(player) do
		if not used[s] then
			return s
		end
	end
	return nil
end

-- growth: returns true when the Floatie reached a new stage
local function growFloatie(f, seconds)
	local changed = false
	f.growth = (f.growth or 0) + seconds
	while true do
		local st = Config.Stages[f.stage]
		if not st or not st.growTime then
			f.growth = 0
			break
		end
		if f.growth >= st.growTime then
			f.growth -= st.growTime
			f.stage += 1
			changed = true
		else
			break
		end
	end
	return changed
end

local function timeToNextStage(player, f)
	local st = Config.Stages[f.stage]
	if not st or not st.growTime then
		return nil
	end
	return (st.growTime - (f.growth or 0)) / growthMultiplier(player)
end

---------------------------------------------------------------------
-- Pedestals
---------------------------------------------------------------------
local function pedestalTopCF(base, slot)
	local ped = base.pedestals[slot]
	return ped.CFrame * CFrame.new(0, ped.Size.Y / 2, 0)
end

local function updatePedestal(base, slot)
	local ped = base.pedestals[slot]
	local f = base.slotData[slot]
	local unlocked = base.owner ~= nil and slot <= pedestalCount(base.owner)
	ped:SetAttribute("HasFloatie", f ~= nil)
	ped:SetAttribute("Unlocked", unlocked)
	ped.Color = if unlocked then base.color else Color3.fromRGB(95, 95, 105)
	ped.Material = if unlocked then Enum.Material.SmoothPlastic else Enum.Material.Slate
	if f then
		local def = Config.FloatieById[f.id]
		local st = Config.Stages[f.stage] or Config.Stages[1]
		ped.StealPrompt.ObjectText = def.name .. " (" .. st.name .. ")"
		ped.StealPrompt.HoldDuration = st.stealTime
		ped.SellPrompt.ObjectText = def.name
		ped.SellPrompt.ActionText = "Sell for " .. Config.Format(sellValue(f))
	end
end

local function refreshLabel(player, f, model)
	local def = Config.FloatieById[f.id]
	local extra = nil
	local t = timeToNextStage(player, f)
	if t then
		local nextStage = Config.Stages[f.stage + 1]
		extra = "→ " .. nextStage.name .. " in " .. Config.FormatTime(t)
	else
		extra = "🎈 FULLY INFLATED"
	end
	FloatieModel.SetLabel(model, def, f.mut, f.stage, floatieIncome(f) * incomeMultiplier(player), extra)
end

local function removeFromPedestal(base, slot)
	if base.models[slot] then
		base.models[slot]:Destroy()
	end
	base.models[slot] = nil
	base.slotData[slot] = nil
	updatePedestal(base, slot)
end

local function placeFloatie(player, f)
	local prof = profiles[player]
	if not prof then
		return
	end
	local base = bases[prof.base]
	if not f.slot or f.slot > pedestalCount(player) then
		return -- stored, but no pedestal for it right now
	end
	local def = Config.FloatieById[f.id]
	if not def then
		return
	end
	if base.models[f.slot] then
		base.models[f.slot]:Destroy()
	end
	local st = Config.Stages[f.stage] or Config.Stages[1]
	local model = FloatieModel.Build(def, f.mut, st.scale)
	FloatieModel.SetAnchored(model, true)
	model:PivotTo(pedestalTopCF(base, f.slot))
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("Uid", f.uid)
	model.Parent = base.floatieFolder
	base.models[f.slot] = model
	base.slotData[f.slot] = f
	refreshLabel(player, f, model)
	updatePedestal(base, f.slot)
end

local function refreshBase(player)
	local prof = profiles[player]
	if not prof then
		return
	end
	local base = bases[prof.base]
	for slot = 1, #base.pedestals do
		removeFromPedestal(base, slot)
	end
	for _, f in ipairs(prof.data.floaties) do
		if not carriedKeys[carryKey(player, f.uid)] then
			placeFloatie(player, f)
		end
	end
	for slot = 1, #base.pedestals do
		updatePedestal(base, slot)
	end
end

-- make sure every Floatie has its own slot (fixes old/corrupt saves)
local function normalizeSlots(player)
	local data = profiles[player].data
	local used = {}
	for _, f in ipairs(data.floaties) do
		if f.slot and not used[f.slot] then
			used[f.slot] = true
		else
			f.slot = nil
		end
	end
	for _, f in ipairs(data.floaties) do
		if not f.slot then
			for s = 1, Config.MaxPedestals do
				if not used[s] then
					f.slot = s
					used[s] = true
					break
				end
			end
		end
	end
end

local function giveFloatie(player, id, mut, stage)
	local prof = profiles[player]
	local slot = freeSlot(player)
	if not prof or not slot or not Config.FloatieById[id] then
		return nil
	end
	local f = { uid = newUid(prof), id = id, mut = mut or "Normal", stage = stage or 1, growth = 0, slot = slot }
	table.insert(prof.data.floaties, f)
	placeFloatie(player, f)
	return f
end

---------------------------------------------------------------------
-- Base lock
---------------------------------------------------------------------
local function lockBase(player, force)
	local prof = profiles[player]
	if not prof then
		return false
	end
	local base = bases[prof.base]
	local t = now()
	if base.lockedUntil > t then
		notify(player, "Your base is already locked!", "info")
		return false
	end
	if not force and t < base.lockReadyAt then
		notify(player, "Lock recharging: " .. math.ceil(base.lockReadyAt - t) .. "s", "error")
		return false
	end
	base.lockedUntil = t + Config.LockDuration
	base.lockReadyAt = base.lockedUntil + Config.LockRecharge
	base.folder:SetAttribute("LockedUntil", base.lockedUntil)
	base.barrier.Transparency = 0.55
	notify(player, "🛡️ Base locked for " .. Config.LockDuration .. "s!", "success")
	return true
end

---------------------------------------------------------------------
-- Carrying (stealing)
---------------------------------------------------------------------
local function clearCarryAttributes(thief)
	thief:SetAttribute("CarryEndsAt", nil)
	thief:SetAttribute("CarryName", nil)
	thief:SetAttribute("CarryHits", nil)
	thief:SetAttribute("CarryPopHits", nil)
end

-- outcome: "delivered" | "popped" | "returned"
local function endCarry(thief, outcome)
	local c = carries[thief]
	if not c then
		return
	end
	carries[thief] = nil
	carriedKeys[carryKey(c.owner, c.f.uid)] = nil
	if c.vf then
		c.vf:Destroy()
	end
	if c.att then
		c.att:Destroy()
	end
	local hum = thief.Character and thief.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = Config.BaseWalkSpeed
	end
	clearCarryAttributes(thief)

	local ownerProf = profiles[c.owner]
	local def = Config.FloatieById[c.f.id]

	if outcome == "delivered" and ownerProf and profiles[thief] then
		local _, idx = findFloatie(ownerProf.data, c.f.uid)
		local slot = freeSlot(thief)
		if idx and slot then
			table.remove(ownerProf.data.floaties, idx)
			local tp = profiles[thief]
			local nf = { uid = newUid(tp), id = c.f.id, mut = c.f.mut, stage = c.f.stage, growth = c.f.growth, slot = slot }
			table.insert(tp.data.floaties, nf)
			if c.model then
				c.model:Destroy()
			end
			placeFloatie(thief, nf)
			tp.data.stats.steals += 1
			ownerProf.data.stats.stolenFrom += 1
			local stageName = Config.Stages[nf.stage].name
			notify(thief, "💰 You stole " .. def.name .. " (" .. stageName .. ")!", "success")
			notify(c.owner, "😭 " .. thief.DisplayName .. " stole your " .. def.name .. "!", "alert")
			local rarityOrder = Config.Rarities[def.rarity].order
			if rarityOrder >= 5 or nf.stage >= 4 or nf.mut ~= "Normal" then
				notifyAll("🚨 " .. thief.DisplayName .. " stole " .. c.owner.DisplayName .. "'s " .. stageName .. " " .. def.name .. "!", "event")
			end
			return
		end
		outcome = "returned"
	end

	-- popped / returned / failed delivery: back to the owner's pedestal
	if c.model then
		c.model:Destroy()
	end
	if ownerProf then
		placeFloatie(c.owner, c.f)
	end
	if outcome == "returned" and thief.Parent then
		notify(thief, "The " .. def.name .. " floated back home.", "info")
	end
end

local function startCarry(thief, base, slot)
	local owner = base.owner
	local f = base.slotData[slot]
	local model = base.models[slot]
	local char = thief.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local head = char and char:FindFirstChild("Head")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (owner and f and model and hum and hum.Health > 0 and head and hrp) then
		return
	end
	local def = Config.FloatieById[f.id]
	local st = Config.Stages[f.stage] or Config.Stages[1]

	-- take it off the pedestal (it stays in the owner's save until delivered)
	base.models[slot] = nil
	base.slotData[slot] = nil
	updatePedestal(base, slot)
	carriedKeys[carryKey(owner, f.uid)] = true

	-- put it on the thief's head
	FloatieModel.SetAnchored(model, false)
	model:PivotTo(head.CFrame * CFrame.new(0, head.Size.Y / 2 + 0.3, 0) * CFrame.Angles(0, math.pi / 2, 0))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = model.PrimaryPart
	weld.Parent = model.PrimaryPart
	model:SetAttribute("CarriedBy", thief.UserId)
	local hl = Instance.new("Highlight")
	hl.FillTransparency = 1
	hl.OutlineColor = Color3.fromRGB(255, 60, 60)
	hl.Parent = model
	model.Parent = map.carried

	-- the twist: bigger balloon = you float + move slower
	local att = Instance.new("Attachment")
	att.Name = "FloatLift"
	att.Parent = hrp
	local vf = Instance.new("VectorForce")
	vf.Attachment0 = att
	vf.RelativeTo = Enum.ActuatorRelativeTo.World
	vf.ApplyAtCenterOfMass = true
	vf.Force = Vector3.new(0, hrp.AssemblyMass * workspace.Gravity * st.lift, 0)
	vf.Parent = hrp
	hum.WalkSpeed = math.max(6, Config.BaseWalkSpeed - st.slow)

	carries[thief] = {
		model = model, owner = owner, f = f, hits = 0, popHits = st.popHits,
		endsAt = now() + Config.CarryTimeout, att = att, vf = vf,
	}
	thief:SetAttribute("CarryEndsAt", now() + Config.CarryTimeout)
	thief:SetAttribute("CarryName", st.name .. " " .. def.name)
	thief:SetAttribute("CarryHits", 0)
	thief:SetAttribute("CarryPopHits", st.popHits)

	notify(owner, "🚨 " .. thief.DisplayName .. " is stealing your " .. def.name .. "! Pop it with your Dart Blaster!", "alert")
	notify(thief, "Got it! Get home before it gets popped!", "success")
end

local function onSteal(thief, base, slot)
	local prof = profiles[thief]
	local owner = base.owner
	if not prof or not prof.loaded or not owner or owner == thief then
		return
	end
	if not base.slotData[slot] or carries[thief] then
		return
	end
	if base.lockedUntil > now() then
		notify(thief, "This base is locked! 🛡️", "error")
		return
	end
	if not freeSlot(thief) then
		notify(thief, "Your base is full! Sell a Floatie first.", "error")
		return
	end
	startCarry(thief, base, slot)
end

local function onSell(player, base, slot)
	if base.owner ~= player then
		return
	end
	local prof = profiles[player]
	local f = base.slotData[slot]
	if not prof or not f then
		return
	end
	local _, idx = findFloatie(prof.data, f.uid)
	if not idx then
		return
	end
	local value = sellValue(f)
	table.remove(prof.data.floaties, idx)
	removeFromPedestal(base, slot)
	prof.data.air += value
	notify(player, "Sold " .. Config.FloatieById[f.id].name .. " for " .. Config.Format(value) .. " Air", "success")
end

local function popCarry(thief, shooter)
	local c = carries[thief]
	if not c then
		return
	end
	local def = Config.FloatieById[c.f.id]
	local pos = if c.model and c.model.PrimaryPart then c.model:GetPivot().Position + Vector3.new(0, 3, 0) else Vector3.zero
	FloatieModel.PopEffect(pos, def.color)
	local owner = c.owner
	local reward = floatieIncome(c.f) * Config.PopReward
	endCarry(thief, "popped")
	KnockbackRE:FireClient(thief, Vector3.new(0, 55, 0))
	notify(thief, "💥 POP! Your stolen " .. def.name .. " flew back home.", "error")
	local sp = profiles[shooter]
	if sp then
		sp.data.stats.pops += 1
		if shooter ~= owner then
			sp.data.air += reward
			notify(shooter, "🦸 Hero pop! +" .. Config.Format(reward) .. " Air", "success")
		else
			notify(shooter, "💥 You popped the thief! " .. def.name .. " is safe.", "success")
		end
	end
	if owner ~= shooter and owner.Parent then
		notify(owner, "🦸 " .. shooter.DisplayName .. " popped the thief! Your " .. def.name .. " is safe.", "success")
	end
end

---------------------------------------------------------------------
-- Dart Blaster
---------------------------------------------------------------------
local function playerFromPart(inst)
	local node = inst
	while node and node ~= workspace do
		local carriedBy = node:GetAttribute("CarriedBy")
		if carriedBy then
			return Players:GetPlayerByUserId(carriedBy), true
		end
		local p = Players:GetPlayerFromCharacter(node)
		if p then
			return p, false
		end
		node = node.Parent
	end
	return nil, false
end

local function dartVisual(from, to)
	local dist = (to - from).Magnitude
	local dart = Instance.new("Part")
	dart.Name = "Dart"
	dart.Anchored = true
	dart.CanCollide = false
	dart.CanQuery = false
	dart.CanTouch = false
	dart.Material = Enum.Material.Neon
	dart.Color = Color3.fromRGB(255, 240, 90)
	dart.Size = Vector3.new(0.25, 0.25, 1.4)
	dart.CFrame = CFrame.lookAt(from, to)
	dart.Parent = workspace
	TweenService:Create(dart, TweenInfo.new(math.clamp(dist / 220, 0.05, 0.5), Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - from)) }):Play()
	Debris:AddItem(dart, 0.6)
end

FireDartRE.OnServerEvent:Connect(function(player, target)
	if typeof(target) ~= "Vector3" then
		return
	end
	local prof = profiles[player]
	if not prof or carries[player] then
		return
	end
	local clock = os.clock()
	if clock < prof.dartReady then
		return
	end
	prof.dartReady = clock + Config.DartCooldown
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not head or not char:FindFirstChild("Dart Blaster") then
		return
	end
	local origin = head.Position
	local dir = target - origin
	if dir.Magnitude < 0.1 then
		return
	end
	dir = dir.Unit * Config.DartRange
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	local result = workspace:Raycast(origin, dir, params)
	dartVisual(origin, if result then result.Position else origin + dir)
	if not result then
		return
	end
	local victim, hitBalloon = playerFromPart(result.Instance)
	if not victim or victim == player then
		return
	end
	local c = carries[victim]
	if c then
		c.hits += 1
		victim:SetAttribute("CarryHits", c.hits)
		if c.hits >= c.popHits then
			popCarry(victim, player)
		end
	elseif not hitBalloon then
		KnockbackRE:FireClient(victim, dir.Unit * Config.DartKnockback + Vector3.new(0, 18, 0))
	end
end)

---------------------------------------------------------------------
-- Pump Line
---------------------------------------------------------------------
local lineDir = (map.line.endPos - map.line.startPos).Unit
local function lineCF(t)
	local pos = map.line.startPos:Lerp(map.line.endPos, t)
	return CFrame.lookAt(pos, pos + lineDir) * CFrame.Angles(0, math.pi / 2, 0)
end

local function rollFloatie()
	local ev, evName = activeEvent()
	if evName == "SecretSkies" and rng:NextNumber() < ev.secretChance then
		return Config.FloatieById.Stormserpent
	end
	local total = 0
	for _, r in pairs(Config.Rarities) do
		total += r.weight
	end
	local roll = rng:NextNumber() * total
	local rarity = "Common"
	for name, r in pairs(Config.Rarities) do
		if r.weight > 0 then
			roll -= r.weight
			if roll <= 0 then
				rarity = name
				break
			end
		end
	end
	local pool = {}
	for _, f in ipairs(Config.Floaties) do
		if f.rarity == rarity then
			table.insert(pool, f)
		end
	end
	if #pool == 0 then
		return Config.Floaties[1]
	end
	return pool[rng:NextInteger(1, #pool)]
end

local function rollMutation()
	local ev, evName = activeEvent()
	local mult = if ev and ev.mutationMult then ev.mutationMult else 1
	for i = #Config.Mutations, 2, -1 do
		local m = Config.Mutations[i]
		local chance
		if m.eventOnly then
			chance = if evName == m.eventOnly then m.eventChance else 0
		else
			chance = m.chance * mult
		end
		if rng:NextNumber() < chance then
			return m.id
		end
	end
	return "Normal"
end

local function onBuy(player, item)
	if item.bought then
		return
	end
	local prof = profiles[player]
	if not prof or not prof.loaded then
		return
	end
	if carries[player] then
		notify(player, "You can't buy while carrying a Floatie!", "error")
		return
	end
	local price = item.def.price
	if prof.data.air < price then
		notify(player, "Not enough Air! You need " .. Config.Format(price) .. ".", "error")
		return
	end
	if not freeSlot(player) then
		notify(player, "Your base is full! Sell a Floatie or Rebirth.", "error")
		return
	end
	item.bought = true
	prof.data.air -= price
	player:SetAttribute("Air", prof.data.air) -- now, so the HUD drops at once (not at the next 1 s tick)
	local pos = item.model:GetPivot().Position
	item.model:Destroy()
	local idx = table.find(lineItems, item)
	if idx then
		table.remove(lineItems, idx)
	end
	FloatieModel.PopEffect(pos + Vector3.new(0, 2, 0), item.def.color)
	giveFloatie(player, item.def.id, item.mut, 1)
	local label = if item.mut ~= "Normal" then item.mut .. " " .. item.def.name else item.def.name
	notify(player, "🎈 You got " .. label .. "!", "success")
end

local function spawnLineFloatie()
	local def = rollFloatie()
	local mut = rollMutation()
	local model = FloatieModel.Build(def, mut, 1)
	FloatieModel.SetAnchored(model, true)
	model:PivotTo(lineCF(0))
	local f = { id = def.id, mut = mut, stage = 1 }
	FloatieModel.SetLabel(model, def, mut, 1, floatieIncome(f), "💰 " .. Config.Format(def.price) .. " Air")
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = "Buy"
	pr.ObjectText = def.name .. " — " .. Config.Format(def.price) .. " Air"
	pr.HoldDuration = 0
	pr.MaxActivationDistance = 14
	pr.RequiresLineOfSight = false
	pr.Parent = model:FindFirstChild("Body") or model.PrimaryPart
	model.Parent = map.line.folder

	local item = { model = model, def = def, mut = mut, t = 0, bought = false }
	pr.Triggered:Connect(function(player)
		onBuy(player, item)
	end)
	table.insert(lineItems, item)

	if Config.Rarities[def.rarity].order >= 5 or mut == "Rainbow" or mut == "Thunder" then
		local label = if mut ~= "Normal" then mut .. " " .. def.name else def.name
		notifyAll("👀 A " .. string.upper(def.rarity) .. " " .. label .. " is on the Pump Line!", "event")
	end
end

---------------------------------------------------------------------
-- Events
---------------------------------------------------------------------
-- nextEventAt is mirrored to ReplicatedStorage "NextEventAt" (server time)
-- every time it is assigned, so the HUD event timer can count down to it.
local nextEventAt = now() + Config.EventInterval
ReplicatedStorage:SetAttribute("NextEventAt", nextEventAt)

local function startEvent(name, by)
	local ev = Config.Events[name]
	if not ev then
		return false
	end
	ReplicatedStorage:SetAttribute("Event", name)
	ReplicatedStorage:SetAttribute("EventEndsAt", now() + ev.duration)
	-- event income (Golden Hour) changes Cash / boost % right away
	for p, prof in pairs(profiles) do
		if prof.loaded then
			publishMultipliers(p)
		end
	end
	local thanks = if by then " (thanks " .. by .. "!)" else ""
	notifyAll(ev.title .. " — " .. ev.desc .. thanks, "event")
	nextEventAt = now() + ev.duration + Config.EventInterval
	ReplicatedStorage:SetAttribute("NextEventAt", nextEventAt)
	return true
end

local function randomEvent()
	local names = {}
	for name in pairs(Config.Events) do
		table.insert(names, name)
	end
	table.sort(names)
	startEvent(names[rng:NextInteger(1, #names)])
end

---------------------------------------------------------------------
-- Monetization
---------------------------------------------------------------------
local function loadPasses(player)
	local prof = profiles[player]
	for name, info in pairs(Config.GamePasses) do
		if RunService:IsStudio() and Config.TestPassesInStudio then
			prof.passes[name] = true
		elseif info.id ~= 0 then
			local success, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, info.id)
			end)
			if success and owns then
				prof.passes[name] = true
			end
		end
		player:SetAttribute("Pass_" .. name, prof.passes[name] == true)
	end
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if not purchased then
		return
	end
	local prof = profiles[player]
	if not prof then
		return
	end
	for name, info in pairs(Config.GamePasses) do
		if info.id == passId then
			prof.passes[name] = true
			player:SetAttribute("Pass_" .. name, true)
			publishMultipliers(player) -- DoubleAir / VIP change Cash right away
			notify(player, "Thanks for buying " .. info.title .. "! 💖", "success")
			if name == "ExtraPedestals" then
				refreshBase(player)
			end
		end
	end
end)

local function grantProduct(player, name)
	local prof = profiles[player]
	if name == "AirPackSmall" then
		prof.data.air += math.max(500, prof.incomePerSec * 300)
	elseif name == "AirPackLarge" then
		prof.data.air += math.max(3000, prof.incomePerSec * 1800)
	elseif name == "InstantLock" then
		local base = bases[prof.base]
		base.lockedUntil = 0
		lockBase(player, true)
	elseif name == "ServerHeliumRain" then
		startEvent("HeliumRain", player.DisplayName)
	else
		return false
	end
	notify(player, "Purchase complete: " .. Config.DevProducts[name].title .. " 💖", "success")
	return true
end

MarketplaceService.ProcessReceipt = function(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local prof = player and profiles[player]
	if not prof or not prof.loaded then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(prof.data.receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local productName = nil
	for name, info in pairs(Config.DevProducts) do
		if info.id == receipt.ProductId then
			productName = name
		end
	end
	if not productName or not grantProduct(player, productName) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(prof.data.receipts, receipt.PurchaseId)
	while #prof.data.receipts > 50 do
		table.remove(prof.data.receipts, 1)
	end
	DataService.Save(player, prof)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

---------------------------------------------------------------------
-- Rebirth + codes
---------------------------------------------------------------------
RebirthRE.OnServerEvent:Connect(function(player)
	local prof = profiles[player]
	if not prof or not prof.loaded or carries[player] then
		return
	end
	local cost = Config.RebirthCost(prof.data.rebirths)
	if prof.data.air < cost then
		notify(player, "You need " .. Config.Format(cost) .. " Air to rebirth.", "error")
		return
	end
	for thief, c in pairs(carries) do
		if c.owner == player then
			endCarry(thief, "returned")
		end
	end
	local best, bestIncome = nil, -1
	for _, f in ipairs(prof.data.floaties) do
		local inc = floatieIncome(f)
		if inc > bestIncome then
			best, bestIncome = f, inc
		end
	end
	prof.data.rebirths += 1
	prof.data.air = Config.StartingAir
	player:SetAttribute("Air", prof.data.air) -- the HUD drops at once
	prof.data.floaties = {}
	if best then
		best.slot = 1
		table.insert(prof.data.floaties, best)
	end
	refreshBase(player)
	player:SetAttribute("Rebirths", prof.data.rebirths)
	publishMultipliers(player)
	notifyAll("🌟 " .. player.DisplayName .. " reached Rebirth " .. prof.data.rebirths .. "!", "event")
end)

RedeemRF.OnServerInvoke = function(player, code)
	local prof = profiles[player]
	if not prof or not prof.loaded or typeof(code) ~= "string" or #code > 30 then
		return false, "Try again"
	end
	code = string.upper((string.gsub(code, "%s", "")))
	local reward = Config.Codes[code]
	if not reward then
		return false, "Invalid code"
	end
	if prof.data.codes[code] then
		return false, "Already redeemed"
	end
	if reward.floatie and not freeSlot(player) then
		return false, "Base full — sell a Floatie first"
	end
	prof.data.codes[code] = true
	if reward.air then
		prof.data.air += reward.air
	end
	if reward.floatie then
		giveFloatie(player, reward.floatie, reward.mutation, 1)
	end
	return true, "Code redeemed! 🎉"
end

---------------------------------------------------------------------
-- Home button: teleport to your base spawn. Later stages add more
-- reasons to refuse inside canGoHome.
---------------------------------------------------------------------
local function canGoHome(player)
	if carries[player] then
		return false, "You can't go Home while carrying a Floatie!"
	end
	return true, nil
end

RequestHomeRE.OnServerEvent:Connect(function(player)
	local prof = profiles[player]
	if not prof or not prof.loaded then
		return
	end
	local clock = os.clock()
	if clock < prof.homeReady then
		return -- rate limit (silent)
	end
	-- 0.5 s of slack: the HUD waits the full cooldown between clicks, but lag
	-- can bring two requests here a little closer together than that
	prof.homeReady = clock + Config.HomeCooldown - 0.5
	local ok, reason = canGoHome(player)
	if not ok then
		notify(player, reason, "error")
		return
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 or not char:FindFirstChild("HumanoidRootPart") then
		return
	end
	char:PivotTo(bases[prof.base].spawn.CFrame * CFrame.new(0, 4, 0)) -- same as the join teleport (onPlayerAdded)
end)

---------------------------------------------------------------------
-- Admin commands
---------------------------------------------------------------------
local function isAdmin(player)
	if RunService:IsStudio() or table.find(Config.AdminUserIds, player.UserId) then
		return true
	end
	return game.CreatorType == Enum.CreatorType.User and game.CreatorId == player.UserId
end

local function onChatted(player, msg)
	if not isAdmin(player) or string.sub(msg, 1, 1) ~= ";" then
		return
	end
	local args = string.split(string.sub(msg, 2), " ")
	local cmd = string.lower(args[1] or "")
	local prof = profiles[player]
	if not prof then
		return
	end
	if cmd == "event" then
		if not startEvent(args[2] or "", "the admin") then
			notify(player, "Unknown event. Try HeliumRain, GoldenHour, WindyDay, Thunderstorm, SecretSkies", "error")
		end
	elseif cmd == "give" then
		local f = giveFloatie(player, args[2] or "", args[3] or "Normal", tonumber(args[4]) or 1)
		notify(player, if f then "Given!" else "Unknown Floatie id or base full", if f then "success" else "error")
	elseif cmd == "air" then
		prof.data.air += tonumber(args[2]) or 0
	elseif cmd == "grow" then
		for _, f in ipairs(prof.data.floaties) do
			f.stage = math.min(#Config.Stages, f.stage + 1)
			f.growth = 0
		end
		refreshBase(player)
	end
end

---------------------------------------------------------------------
-- Players
---------------------------------------------------------------------
local function assignBase(player)
	for i, base in ipairs(bases) do
		if not base.owner then
			base.owner = player
			base.lockedUntil = 0
			base.lockReadyAt = 0
			base.folder:SetAttribute("OwnerUserId", player.UserId)
			base.folder:SetAttribute("LockedUntil", 0)
			base.signLabel.Text = player.DisplayName .. "'s Base"
			return i
		end
	end
	return nil
end

local function releaseBase(index)
	local base = bases[index]
	for slot = 1, #base.pedestals do
		removeFromPedestal(base, slot)
	end
	base.owner = nil
	base.folder:SetAttribute("OwnerUserId", 0)
	base.folder:SetAttribute("LockedUntil", 0)
	base.barrier.Transparency = 1
	base.signLabel.Text = "Empty Base"
	for slot = 1, #base.pedestals do
		updatePedestal(base, slot)
	end
end

local function onCharacterAdded(player, character)
	local prof = profiles[player]
	local hum = character:WaitForChild("Humanoid", 10)
	if not hum or not prof then
		return
	end
	hum.WalkSpeed = Config.BaseWalkSpeed
	hum.Died:Connect(function()
		endCarry(player, "returned")
	end)
	if prof.passes.VIP then
		local head = character:WaitForChild("Head", 5)
		if head then
			local gui = Instance.new("BillboardGui")
			gui.Size = UDim2.fromOffset(90, 26)
			gui.StudsOffset = Vector3.new(0, 2.6, 0)
			gui.MaxDistance = 80
			gui.Parent = head
			local t = Instance.new("TextLabel")
			t.Size = UDim2.fromScale(1, 1)
			t.BackgroundTransparency = 1
			t.Font = Enum.Font.FredokaOne
			t.TextScaled = true
			t.Text = "⭐ VIP"
			t.TextColor3 = Color3.fromRGB(255, 210, 60)
			t.TextStrokeTransparency = 0
			t.Parent = gui
		end
	end
end

local function onPlayerAdded(player)
	local data, canSave = DataService.Load(player)
	if not player.Parent then
		return
	end
	if not data then
		player:Kick("We couldn't load your Floaties. Please rejoin in a minute!")
		return
	end
	local baseIndex = assignBase(player)
	if not baseIndex then
		player:Kick("This server is full, please join another one!")
		return
	end
	local prof = { data = data, canSave = canSave, base = baseIndex, passes = {}, incomePerSec = 0, dartReady = 0, homeReady = 0, loaded = false }
	profiles[player] = prof
	loadPasses(player)
	normalizeSlots(player)

	-- offline progress: Floaties kept inflating + some Air while you were away
	local elapsed = math.max(0, os.time() - (data.lastOnline or os.time()))
	if elapsed > 60 and #data.floaties > 0 then
		local growSec = math.min(elapsed, Config.OfflineGrowthCap) * growthMultiplier(player)
		local count = pedestalCount(player)
		local total = 0
		for _, f in ipairs(data.floaties) do
			growFloatie(f, growSec)
			if f.slot and f.slot <= count then
				total += floatieIncome(f)
			end
		end
		local earned = math.floor(total * incomeMultiplier(player) * Config.OfflineIncomeRate * math.min(elapsed, Config.OfflineIncomeCap))
		data.air += earned
		task.delay(3, function()
			if player.Parent then
				notify(player, "💤 While you were away your Floaties inflated and earned " .. Config.Format(earned) .. " Air!", "success")
			end
		end)
	end

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local airStat = Instance.new("StringValue")
	airStat.Name = "Air"
	airStat.Value = Config.Format(data.air)
	airStat.Parent = ls
	local rebirthStat = Instance.new("IntValue")
	rebirthStat.Name = "Rebirths"
	rebirthStat.Value = data.rebirths
	rebirthStat.Parent = ls
	local stealStat = Instance.new("IntValue")
	stealStat.Name = "Steals"
	stealStat.Value = data.stats.steals
	stealStat.Parent = ls
	ls.Parent = player
	prof.stats = { air = airStat, rebirths = rebirthStat, steals = stealStat }

	player:SetAttribute("BaseIndex", baseIndex)
	player:SetAttribute("Air", data.air)
	player:SetAttribute("Rebirths", data.rebirths)
	player:SetAttribute("IncomePerSec", 0)
	publishMultipliers(player) -- CashMultiplier / LuckMultiplier / BoostPercent for the HUD
	-- brand-new players get the tutorial (see ClientMain/Tutorial)
	player:SetAttribute("ShowTutorial", #data.floaties == 0 and data.rebirths == 0 and data.stats.steals == 0)
	player.RespawnLocation = bases[baseIndex].spawn
	refreshBase(player)
	prof.loaded = true

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
		player.Character:PivotTo(bases[baseIndex].spawn.CFrame * CFrame.new(0, 4, 0))
	end
	player.Chatted:Connect(function(msg)
		onChatted(player, msg)
	end)

	if not canSave and not RunService:IsStudio() then
		notify(player, "⚠️ Saving is unavailable right now — progress may not save.", "error")
	end
	notify(player, "Welcome to " .. Config.GameName .. "! Buy Floaties on the Pump Line 🎈", "info")
end

local function onPlayerRemoving(player)
	endCarry(player, "returned")
	for thief, c in pairs(carries) do
		if c.owner == player then
			endCarry(thief, "returned")
		end
	end
	local prof = profiles[player]
	if not prof then
		return
	end
	DataService.Save(player, prof)
	releaseBase(prof.base)
	profiles[player] = nil
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

-- pedestal + lock prompts
for _, base in ipairs(bases) do
	for slot, ped in ipairs(base.pedestals) do
		ped.StealPrompt.Triggered:Connect(function(player)
			onSteal(player, base, slot)
		end)
		ped.SellPrompt.Triggered:Connect(function(player)
			onSell(player, base, slot)
		end)
	end
	base.lockPrompt.Triggered:Connect(function(player)
		if base.owner == player then
			lockBase(player, false)
		end
	end)
end

game:BindToClose(function()
	for thief in pairs(carries) do
		endCarry(thief, "returned")
	end
	local threads = 0
	for player, prof in pairs(profiles) do
		threads += 1
		task.spawn(function()
			DataService.Save(player, prof)
			threads -= 1
		end)
	end
	local start = os.clock()
	while threads > 0 and os.clock() - start < 25 do
		task.wait(0.2)
	end
end)

---------------------------------------------------------------------
-- Loops
---------------------------------------------------------------------
-- Pump Line movement + spawning
local spawnTimer = 0
local lineAccum = 0
RunService.Heartbeat:Connect(function(dt)
	spawnTimer += dt
	if spawnTimer >= Config.PumpInterval then
		spawnTimer = 0
		spawnLineFloatie()
	end
	lineAccum += dt
	if lineAccum < 1 / 20 then
		return
	end
	local step = lineAccum / Config.PumpTravelTime
	lineAccum = 0
	for i = #lineItems, 1, -1 do
		local item = lineItems[i]
		item.t += step
		if item.t >= 1 then
			item.model:Destroy()
			table.remove(lineItems, i)
		else
			item.model:PivotTo(lineCF(item.t))
		end
	end
end)

-- carries: delivery, timeouts, locked-base shoves (5x per second)
local function insideBase(base, pos)
	local rel = base.cf:PointToObjectSpace(pos)
	return math.abs(rel.X) <= base.size.X / 2 and math.abs(rel.Z) <= base.size.Z / 2 and rel.Y < 40
end

task.spawn(function()
	while true do
		task.wait(0.2)
		local t = now()
		for thief, c in pairs(carries) do
			if not thief.Parent or t >= c.endsAt then
				endCarry(thief, "returned")
			else
				local prof = profiles[thief]
				local hrp = thief.Character and thief.Character:FindFirstChild("HumanoidRootPart")
				if prof and hrp and insideBase(bases[prof.base], hrp.Position) then
					endCarry(thief, "delivered")
				end
			end
		end
		for _, base in ipairs(bases) do
			if base.owner and base.lockedUntil > t then
				for _, p in ipairs(Players:GetPlayers()) do
					local hrp = p ~= base.owner and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
					if hrp and insideBase(base, hrp.Position) then
						local out = hrp.Position - base.cf.Position
						out = Vector3.new(out.X, 0, out.Z)
						if out.Magnitude < 1 then
							out = base.cf.LookVector
						end
						KnockbackRE:FireClient(p, out.Unit * 90 + Vector3.new(0, 30, 0))
					end
				end
			end
		end
	end
end)

-- income, growth, labels, lock status, events, wind, autosave (1x per second)
task.spawn(function()
	local tick = 0
	while true do
		task.wait(1)
		tick += 1
		local t = now()

		for player, prof in pairs(profiles) do
			if prof.loaded then
				local base = bases[prof.base]
				local gm = growthMultiplier(player)
				local count = pedestalCount(player)
				local total = 0
				for _, f in ipairs(prof.data.floaties) do
					if f.slot and f.slot <= count and not carriedKeys[carryKey(player, f.uid)] then
						local changed = growFloatie(f, gm)
						total += floatieIncome(f)
						if changed then
							local def = Config.FloatieById[f.id]
							local model = base.models[f.slot]
							local pos = if model then model:GetPivot().Position else pedestalTopCF(base, f.slot).Position
							placeFloatie(player, f) -- rebuild at the new size
							FloatieModel.PopEffect(pos + Vector3.new(0, 3, 0), def.color)
							notify(player, "🎈 Your " .. def.name .. " inflated to " .. Config.Stages[f.stage].name .. "!", "success")
						elseif tick % 3 == 0 and base.models[f.slot] then
							refreshLabel(player, f, base.models[f.slot])
						end
					end
				end
				local income = total * incomeMultiplier(player)
				prof.incomePerSec = income
				prof.data.air += income
				player:SetAttribute("Air", prof.data.air)
				player:SetAttribute("IncomePerSec", income)
				player:SetAttribute("Rebirths", prof.data.rebirths)
				publishMultipliers(player) -- also catches an event ending
				prof.stats.air.Value = Config.Format(prof.data.air)
				prof.stats.rebirths.Value = prof.data.rebirths
				prof.stats.steals.Value = prof.data.stats.steals
			end
		end

		-- lock buttons
		for _, base in ipairs(bases) do
			if base.owner then
				if base.lockedUntil > t then
					base.lockStatus.Text = "🛡️ LOCKED " .. math.ceil(base.lockedUntil - t) .. "s"
				else
					base.barrier.Transparency = 1
					if base.lockReadyAt > t then
						base.lockStatus.Text = "Recharging " .. math.ceil(base.lockReadyAt - t) .. "s"
					else
						base.lockStatus.Text = "LOCK READY"
					end
				end
			else
				base.lockStatus.Text = ""
			end
		end

		-- events
		local ev, evName = activeEvent()
		if not ev and (ReplicatedStorage:GetAttribute("Event") or "") ~= "" then
			ReplicatedStorage:SetAttribute("Event", "")
		end
		if not ev and t >= nextEventAt and #Players:GetPlayers() > 0 then
			randomEvent()
		end
		if evName == "WindyDay" and tick % 2 == 0 then
			for thief in pairs(carries) do
				local a = rng:NextNumber() * math.pi * 2
				KnockbackRE:FireClient(thief, Vector3.new(math.cos(a), 0, math.sin(a)) * 40 + Vector3.new(0, 10, 0))
			end
		end

		-- autosave every 2 minutes
		if tick % 120 == 0 then
			for player, prof in pairs(profiles) do
				task.spawn(DataService.Save, player, prof)
			end
		end
	end
end)

print(("[%s] server v%s started"):format(Config.GameName, Config.Version))
